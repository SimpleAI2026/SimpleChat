{
  "name": "@simplechat/element",
  "version": "0.1.0",
  "description": "SimpleChat Web Component (<simple-chat>) with shadcn-like B&W UI",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@simplechat/core": "0.1.0",
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "happy-dom": "^17.4.4",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "3.2.4"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SimpleAI2026/SimpleChat",
    "directory": "packages/element"
  }
