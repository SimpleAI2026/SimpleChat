{
  "name": "@simplechat/core",
  "version": "0.1.0",
  "description": "Framework-agnostic OpenAI-compatible chat engine with tools and history",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "3.2.4"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SimpleAI2026/SimpleChat",
    "directory": "packages/core"
  }
